}

model ProviderCatalogItem {
  id                     String                  @id @default(uuid()) @db.Uuid
  category               ProviderCatalogCategory
  provider               String
  externalKey            String                  @map("external_key")
  displayName            String                  @map("display_name")
  capabilitiesJson       Json?                   @map("capabilities_json")
  status                 ProviderCatalogStatus   @default(ACTIVE)
  deprecationNote        String?                 @map("deprecation_note") @db.Text
  credentialEnvVar       String?                 @map("credential_env_var")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  priceVersions          ProviderPriceVersion[]
  primaryConfigurations  AiFeatureModelConfig[]  @relation("AiFeaturePrimaryCatalogItem")
  fallbackConfigurations AiFeatureModelConfig[]  @relation("AiFeatureFallbackCatalogItem")
  usageEvents            ProviderUsageEvent[]

  @@unique([category, provider, externalKey])
  @@index([category, status])
  @@index([provider, status])
  @@map("provider_catalog_items")
}

model ProviderPriceVersion {
  id              String               @id @default(uuid()) @db.Uuid
  catalogItemId   String               @map("catalog_item_id") @db.Uuid
  catalogItem     ProviderCatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
