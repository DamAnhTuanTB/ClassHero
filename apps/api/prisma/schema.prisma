generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTI_STATEMENT_TRUE_FALSE
  TEXT_INPUT
}

enum ContentSource {
  ADMIN
  AI
}

enum ReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  HIDDEN
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LearningPathKind {
  CATALOG
  PERSONALIZED
}

enum PaymentProvider {
  PAYOS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum FileProvider {
  MINIO_LOCAL
  CLOUDFLARE_R2
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum FileStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum FilePurpose {
  AVATAR
  LESSON_DOCUMENT
  EDITOR_IMAGE
  QUESTION_IMAGE
  NOTE_IMAGE
  AI_DIAGRAM
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum SearchablePdfValidationStatus {
  PENDING
  PASSED
  WARNING
  FAILED
  EXPIRED
  PROMOTED
}

enum LessonDocumentKind {
  PRIMARY_FROM_SOURCE
  SUPPLEMENT
  HOMEWORK
}

enum LessonType {
  BASIC
  LIVE
}

enum LessonMaterialType {
  PDF
  IMAGE
  TEXT
  RICH_TEXT
  LINK
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  CANCELLED
}

enum NotificationKind {
  SYSTEM
  MANUAL
}

enum NotificationType {
  LESSON_REMINDER
  TEST_OPENED
  LESSON_COMPLETED
  TEST_RESULT
  STUDY_LATE
  MANUAL
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  ZALO
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportTargetType {
  QUIZ_QUESTION
  FLASHCARD
  TEST_QUESTION
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ModerationAction {
  EDIT
  HIDE
  RESTORE
  MARK_RESOLVED
  REJECT
}

enum AiProviderName {
  OPENAI
  GEMINI
}

enum AiGenerationType {
  SUMMARY
  QUIZ
  FLASHCARD
  TEST
  EXPLANATION
  CHAT
  EMBEDDING
  DOCUMENT_EXTRACT
  DIAGRAM_RENDER
}

enum AiGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiExplanationTargetType {
  QUIZ_QUESTION
  FLASHCARD
  TEST_QUESTION
}

enum AiChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FavoriteTargetType {
  QUIZ_QUESTION
  FLASHCARD
}

enum XpEventSource {
  LESSON_COMPLETED
  BONUS
  ADMIN_ADJUSTMENT
}

enum NewsType {
  NEWS
  EVENT
  LIVESTREAM
}

enum BackgroundJobQueue {
  DOCUMENT_PROCESSING
  EMBEDDING
  AI_GENERATION
  NOTIFICATION_DELIVERY
  EMAIL_DELIVERY
  ZALO_DELIVERY
  DIAGRAM_RENDERING
  PAYMENT_POSTPROCESS
  PERSONAL_LEARNING_PATH_CLONE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StemFigureStatus {
  QUEUED
  RENDERING
  REPAIRING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

enum StemFigureTheme {
  LIGHT
}

enum StemFigureAttemptKind {
  INITIAL
  AI_REPAIR
  INFRA_RETRY
  ADMIN_EDIT
  ADMIN_REGENERATE
  ADMIN_UPLOAD
  MANUAL_COMPILER_REPAIR
  MANUAL_VALIDATOR_REPAIR
  COMPILE_PREVIEW
}

enum StemFigureAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum StemFigureRevisionStatus {
  QUEUED
  RENDERING
  REPAIRING
  DRAFT_READY
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

enum StemFigureSourceKind {
  AI_TEX
  ADMIN_UPLOAD
}

enum StemFigureRevisionOrigin {
  INITIAL_AI
  AUTO_REPAIR
  ADMIN_EDIT
  ADMIN_REGENERATE
  ADMIN_UPLOAD
  MANUAL_REPAIR
}

enum ProviderCatalogCategory {
  AI_MODEL
  OCR_SERVICE
}

enum ProviderCatalogStatus {
  ACTIVE
  DEPRECATED
  DISABLED
}

enum ProviderBillingMode {
  TOKEN
  PAGE
  REQUEST
}

enum ProviderUsageMetric {
  INPUT_TOKEN
  CACHED_INPUT_TOKEN
  OUTPUT_TOKEN
  PAGE
  REQUEST
}

enum ProviderUsageStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProviderUsageSource {
  MEASURED
  RECONSTRUCTED
}

enum ProviderBudgetScope {
  ALL
  AI
  OCR
}

enum ProviderBudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  UNCERTAIN
}

model User {
  id                          String                    @id @default(uuid()) @db.Uuid
  role                        UserRole
  status                      UserStatus                @default(ACTIVE)
  email                       String?                   @unique
  phone                       String?                   @unique
  username                    String?                   @unique
  passwordHash                String                    @map("password_hash")
  fullName                    String?                   @map("full_name")
  gender                      Gender                    @default(UNKNOWN)
  dateOfBirth                 DateTime?                 @map("date_of_birth") @db.Date
  avatarFileId                String?                   @map("avatar_file_id") @db.Uuid
  avatarFile                  File?                     @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  lastLoginAt                 DateTime?                 @map("last_login_at")
  emailVerifiedAt             DateTime?                 @map("email_verified_at")
  phoneVerifiedAt             DateTime?                 @map("phone_verified_at")
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")
  deletedAt                   DateTime?                 @map("deleted_at")
  studentProfile              StudentProfile?
  parentProfile               ParentProfile?
  uploadedFiles               File[]                    @relation("FileUploadedBy")
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  parentLinksAsParent         ParentStudentLink[]       @relation("ParentStudentLinksParent")
  parentLinksAsStudent        ParentStudentLink[]       @relation("ParentStudentLinksStudent")
  backgroundJobs              BackgroundJob[]           @relation("BackgroundJobOwner")
  createdDocumentPageRanges   LessonDocumentPageRange[] @relation("LessonDocumentPageRangeCreatedBy")
  auditLogs                   AuditLog[]                @relation("AuditLogActor")
  createdLearningPaths        LearningPath[]            @relation("LearningPathCreatedBy")
  updatedLearningPaths        LearningPath[]            @relation("LearningPathUpdatedBy")
  createdLearningPathChapters LearningPathChapter[]     @relation("LearningPathChapterCreatedBy")
  updatedLearningPathChapters LearningPathChapter[]     @relation("LearningPathChapterUpdatedBy")
  createdLessons              Lesson[]                  @relation("LessonCreatedBy")
  updatedLessons              Lesson[]                  @relation("LessonUpdatedBy")
  createdLessonSummaries      LessonSummary[]           @relation("LessonSummaryCreatedBy")
  updatedLessonSummaries      LessonSummary[]           @relation("LessonSummaryUpdatedBy")
  createdStemFigures          StemFigure[]              @relation("StemFigureCreatedBy")
  createdStemFigureRevisions  StemFigureRevision[]      @relation("StemFigureRevisionCreatedBy")
  enrollmentsAsStudent        Enrollment[]              @relation("EnrollmentStudent")
  enrollmentsPaid             Enrollment[]              @relation("EnrollmentPaidBy")
  lessonProgress              LessonProgress[]          @relation("LessonProgressStudent")
  generatedQuizSets           QuizSet[]                 @relation("QuizSetGeneratedBy")
  createdQuizSets             QuizSet[]                 @relation("QuizSetCreatedBy")
  updatedQuizSets             QuizSet[]                 @relation("QuizSetUpdatedBy")
  quizAttempts                QuizAttempt[]             @relation("QuizAttemptStudent")
  generatedFlashcardSets      FlashcardSet[]            @relation("FlashcardSetGeneratedBy")
  createdFlashcardSets        FlashcardSet[]            @relation("FlashcardSetCreatedBy")
  updatedFlashcardSets        FlashcardSet[]            @relation("FlashcardSetUpdatedBy")
  flashcardProgress           FlashcardProgress[]       @relation("FlashcardProgressStudent")
  flashcardStudySessions      FlashcardStudySession[]   @relation("FlashcardStudySessionStudent")
  generatedTestSets           TestSet[]                 @relation("TestSetGeneratedBy")
  createdTestSets             TestSet[]                 @relation("TestSetCreatedBy")
  updatedTestSets             TestSet[]                 @relation("TestSetUpdatedBy")
  testAttempts                TestAttempt[]             @relation("TestAttemptStudent")
  studentNotes                StudentNote[]             @relation("StudentNoteStudent")
  lessonVideoComments         LessonVideoComment[]      @relation("LessonVideoCommentStudent")
  favorites                   Favorite[]                @relation("FavoriteStudent")
  createdDiscountCodes        DiscountCode[]            @relation("DiscountCodeCreatedBy")
  paymentsAsPayer             Payment[]                 @relation("PaymentPayer")
  paymentsAsStudent           Payment[]                 @relation("PaymentStudent")
  notificationsReceived       Notification[]            @relation("NotificationRecipient")
  notificationsActed          Notification[]            @relation("NotificationActor")
  reportsSubmitted            Report[]                  @relation("ReportReporter")
  reportActions               ReportAction[]            @relation("ReportActionAdmin")
  aiGenerationsCreated        AiGeneration[]            @relation("AiGenerationCreatedBy")
  aiChatSessions              AiChatSession[]           @relation("AiChatSessionStudent")
  xpEvents                    XpEvent[]                 @relation("XpEventStudent")
  createdNewsItems            NewsItem[]                @relation("NewsItemCreatedBy")
  updatedNewsItems            NewsItem[]                @relation("NewsItemUpdatedBy")

  @@index([role, status])
  @@map("users")
}

model StudentProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade       Int
  childCode   String   @unique @map("child_code")
  address     String?
  displayName String?  @map("display_name")
  totalXp     Int      @default(0) @map("total_xp")
  level       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

model ParentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parent_profiles")
}

model ParentStudentLink {
  id            String   @id @default(uuid()) @db.Uuid
  parentUserId  String   @map("parent_user_id") @db.Uuid
  parentUser    User     @relation("ParentStudentLinksParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentUserId String   @unique @map("student_user_id") @db.Uuid
  studentUser   User     @relation("ParentStudentLinksStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([parentUserId, studentUserId])
  @@map("parent_student_links")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  requestIp String?   @map("request_ip")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model File {
  id                      String                    @id @default(uuid()) @db.Uuid
  provider                FileProvider              @default(CLOUDFLARE_R2)
  purpose                 FilePurpose
  bucket                  String
  objectKey               String                    @unique @map("object_key")
  originalName            String                    @map("original_name")
  mimeType                String                    @map("mime_type")
  sizeBytes               BigInt                    @map("size_bytes")
  visibility              FileVisibility            @default(PRIVATE)
  status                  FileStatus                @default(UPLOADED)
  uploadedById            String?                   @map("uploaded_by_id") @db.Uuid
  uploadedBy              User?                     @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarUsers             User[]                    @relation("UserAvatar")
  thumbnailLearningPaths  LearningPath[]            @relation("LearningPathThumbnail")
  sourceDocuments         SourceDocument[]          @relation("SourceDocumentFile")
  searchablePdfOriginals  SearchablePdfValidation[] @relation("SearchablePdfValidationOriginalFile")
  searchablePdfCandidates SearchablePdfValidation[] @relation("SearchablePdfValidationCandidateFile")
  sourcePageThumbnails    SourceDocumentPage[]      @relation("SourceDocumentPageThumbnail")
  lessonMaterials         LessonMaterial[]          @relation("LessonMaterialFile")
  lessonDocuments         LessonDocument[]          @relation("LessonDocumentFile")
  aiExplanationImages     AiExplanation[]           @relation("AiExplanationImageFile")
  stemFigureDeliveries    StemFigureRevision[]      @relation("StemFigureRevisionDeliveryFile")
  newsItemCovers          NewsItem[]                @relation("NewsItemCoverFile")
  publicUrl               String?                   @map("public_url")
  checksum                String?
  metadataJson            Json?                     @map("metadata_json")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  deletedAt               DateTime?                 @map("deleted_at")

  @@index([purpose, status])
  @@index([uploadedById])
  @@index([visibility, status])
  @@map("files")
}

model BackgroundJob {
  id                         String                      @id @default(uuid()) @db.Uuid
  queue                      BackgroundJobQueue
  status                     BackgroundJobStatus         @default(QUEUED)
  idempotencyKey             String?                     @unique @map("idempotency_key")
  bullmqJobId                String?                     @map("bullmq_job_id")
  ownerUserId                String?                     @map("owner_user_id") @db.Uuid
  ownerUser                  User?                       @relation("BackgroundJobOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lessonId                   String?                     @map("lesson_id") @db.Uuid
  lesson                     Lesson?                     @relation("BackgroundJobLesson", fields: [lessonId], references: [id], onDelete: SetNull)
  lessonDocuments            LessonDocument[]            @relation("LessonDocumentProcessingJob")
  sourceDocuments            SourceDocument[]            @relation("SourceDocumentProcessingJob")
  aiGenerations              AiGeneration[]              @relation("AiGenerationBackgroundJob")
  providerUsageEvents        ProviderUsageEvent[]        @relation("ProviderUsageBackgroundJob")
  providerBudgetReservations ProviderBudgetReservation[] @relation("ProviderBudgetReservationBackgroundJob")
  stemFigureRenderAttempts   StemFigureRenderAttempt[]   @relation("StemFigureRenderAttemptJob")
  resourceType               String?                     @map("resource_type")
  resourceId                 String?                     @map("resource_id") @db.Uuid
  inputMeta                  Json?                       @map("input_meta_json")
  result                     Json?                       @map("result_json")
  errorMessage               String?                     @map("error_message") @db.Text
  attempts                   Int                         @default(0)
  maxAttempts                Int                         @default(3) @map("max_attempts")
  availableAt                DateTime?                   @map("available_at")
  startedAt                  DateTime?                   @map("started_at")
  finishedAt                 DateTime?                   @map("finished_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([bullmqJobId])
  @@index([ownerUserId, createdAt])
  @@index([queue, status])
  @@index([resourceType, resourceId])
  @@map("background_jobs")
}

model LearningPath {
  id                   String                       @id @default(uuid()) @db.Uuid
  kind                 LearningPathKind             @default(CATALOG)
  sourceLearningPathId String?                      @map("source_learning_path_id") @db.Uuid
  sourceLearningPath   LearningPath?                @relation("PersonalLearningPathSource", fields: [sourceLearningPathId], references: [id], onDelete: Restrict)
  personalizedCopies   LearningPath[]               @relation("PersonalLearningPathSource")
  domainId             String                       @map("domain_id") @db.Uuid
  domain               Domain                       @relation(fields: [domainId], references: [id], onDelete: Restrict)
  targetAudiences      LearningPathTargetAudience[]
  title                String
  slug                 String                       @unique
  originalPriceVnd     Int                          @map("original_price_vnd")
  salePriceVnd         Int?                         @map("sale_price_vnd")
  totalChapterCount    Int                          @default(0) @map("total_chapter_count")
  totalLessonCount     Int                          @default(0) @map("total_lesson_count")
  thumbnailFileId      String?                      @map("thumbnail_file_id") @db.Uuid
  thumbnailFile        File?                        @relation("LearningPathThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  descriptionJson      Json?                        @map("description_json")
  startDate            DateTime?                    @map("start_date") @db.Date
  endDate              DateTime?                    @map("end_date") @db.Date
  lessonCountMin       Int?                         @map("lesson_count_min")
  lessonCountMax       Int?                         @map("lesson_count_max")
  status               PublishStatus                @default(DRAFT)
  trialEnabled         Boolean                      @default(false) @map("trial_enabled")
  publishedAt          DateTime?                    @map("published_at")
  sortOrder            Int                          @default(0) @map("sort_order")
  createdById          String?                      @map("created_by_id") @db.Uuid
  createdBy            User?                        @relation("LearningPathCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?                      @map("updated_by_id") @db.Uuid
  updatedBy            User?                        @relation("LearningPathUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  deletedAt            DateTime?                    @map("deleted_at")
  chapters             LearningPathChapter[]
  lessons              Lesson[]
  sourceDocuments      SourceDocument[]
  enrollments          Enrollment[]                 @relation("EnrollmentPurchasedLearningPath")
  deliveredEnrollments Enrollment[]                 @relation("EnrollmentDeliveryLearningPath")
  payments             Payment[]

  @@index([kind, status])
  @@index([sourceLearningPathId])
  @@index([domainId])
  @@index([status])
  @@index([sortOrder])
  @@index([thumbnailFileId])
  @@index([createdById])
  @@index([updatedById])
  @@map("learning_paths")
}

model Domain {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(120)
  slug          String         @unique @db.VarChar(140)
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  learningPaths LearningPath[]

  @@index([sortOrder, name])
  @@map("domains")
}

model TargetAudience {
  id            String                       @id @default(uuid()) @db.Uuid
  code          String                       @unique @db.VarChar(80)
  name          String                       @db.VarChar(120)
  grade         Int?                         @unique
  sortOrder     Int                          @default(0) @map("sort_order")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  learningPaths LearningPathTargetAudience[]

  @@index([sortOrder, name])
  @@map("target_audiences")
}

model LearningPathTargetAudience {
  learningPathId   String         @map("learning_path_id") @db.Uuid
  learningPath     LearningPath   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  targetAudienceId String         @map("target_audience_id") @db.Uuid
  targetAudience   TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@id([learningPathId, targetAudienceId])
  @@index([targetAudienceId, learningPathId])
  @@map("learning_path_target_audiences")
}

model LearningPathChapter {
  id                 String                @id @default(uuid()) @db.Uuid
  sourceChapterId    String?               @map("source_chapter_id") @db.Uuid
  sourceChapter      LearningPathChapter?  @relation("PersonalLearningPathChapterSource", fields: [sourceChapterId], references: [id], onDelete: Restrict)
  personalizedCopies LearningPathChapter[] @relation("PersonalLearningPathChapterSource")
  learningPathId     String                @map("learning_path_id") @db.Uuid
  learningPath       LearningPath          @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  orderIndex         Int                   @map("order_index")
  title              String
  overview           String?
  objectivesJson     Json?                 @map("objectives_json")
  status             PublishStatus         @default(DRAFT)
  createdById        String?               @map("created_by_id") @db.Uuid
  createdBy          User?                 @relation("LearningPathChapterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?               @map("updated_by_id") @db.Uuid
  updatedBy          User?                 @relation("LearningPathChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")
  lessons            Lesson[]

  @@unique([learningPathId, orderIndex])
  @@index([sourceChapterId])
  @@index([learningPathId, status])
  @@index([createdById])
  @@index([updatedById])
  @@map("learning_path_chapters")
}

model Lesson {
  id                     String                      @id @default(uuid()) @db.Uuid
  sourceLessonId         String?                     @map("source_lesson_id") @db.Uuid
  sourceLesson           Lesson?                     @relation("PersonalLearningPathLessonSource", fields: [sourceLessonId], references: [id], onDelete: Restrict)
  personalizedCopies     Lesson[]                    @relation("PersonalLearningPathLessonSource")
  learningPathId         String                      @map("learning_path_id") @db.Uuid
  learningPath           LearningPath                @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  chapterId              String?                     @map("chapter_id") @db.Uuid
  chapter                LearningPathChapter?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  orderIndex             Int                         @map("order_index")
  title                  String
  shortDescription       String?                     @map("short_description")
  lessonType             LessonType                  @default(BASIC) @map("lesson_type")
  liveUrl                String?                     @map("live_url")
  prepMaterialJson       Json?                       @map("prep_material_json")
  scheduledAt            DateTime?                   @map("scheduled_at")
  examOpenAt             DateTime?                   @map("exam_open_at")
  videoUrl               String?                     @map("video_url")
  customVideoSettings    Json?                       @map("custom_video_settings")
  completionMinScore     Decimal                     @default(7) @map("completion_min_score") @db.Decimal(5, 2)
  trialEnabled           Boolean                     @default(false) @map("trial_enabled")
  status                 PublishStatus               @default(DRAFT)
  createdById            String?                     @map("created_by_id") @db.Uuid
  createdBy              User?                       @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?                     @map("updated_by_id") @db.Uuid
  updatedBy              User?                       @relation("LessonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  deletedAt              DateTime?                   @map("deleted_at")
  materials              LessonMaterial[]
  documents              LessonDocument[]
  documentPageRanges     LessonDocumentPageRange[]
  documentChunks         DocumentChunk[]
  summary                LessonSummary?
  progressEntries        LessonProgress[]
  quizSets               QuizSet[]
  quizQuestions          QuizQuestion[]
  quizAttempts           QuizAttempt[]
  flashcardSets          FlashcardSet[]
  flashcards             Flashcard[]
  flashcardProgress      FlashcardProgress[]
  flashcardStudySessions FlashcardStudySession[]
  testSets               TestSet[]
  testQuestions          TestQuestion[]
  testAttempts           TestAttempt[]
  studentNotes           StudentNote[]
  videoComments          LessonVideoComment[]
  favorites              Favorite[]
  backgroundJobs         BackgroundJob[]             @relation("BackgroundJobLesson")
  reports                Report[]
  aiGenerations          AiGeneration[]              @relation("AiGenerationLesson")
