generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum FileProvider {
  CLOUDFLARE_R2
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum FileStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum FilePurpose {
  AVATAR
  LESSON_DOCUMENT
  EDITOR_IMAGE
  QUESTION_IMAGE
  NOTE_IMAGE
  AI_DIAGRAM
}

enum BackgroundJobQueue {
  DOCUMENT_PROCESSING
  EMBEDDING
  AI_GENERATION
  NOTIFICATION_DELIVERY
  EMAIL_DELIVERY
  ZALO_DELIVERY
  DIAGRAM_RENDERING
  PAYMENT_POSTPROCESS
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  role                 UserRole
  status               UserStatus           @default(ACTIVE)
  email                String?              @unique
  phone                String?              @unique
  username             String?              @unique
  passwordHash         String               @map("password_hash")
  fullName             String?              @map("full_name")
  gender               Gender               @default(UNKNOWN)
  dateOfBirth          DateTime?            @map("date_of_birth") @db.Date
  avatarFileId         String?              @map("avatar_file_id") @db.Uuid
  avatarFile           File?                @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  lastLoginAt          DateTime?            @map("last_login_at")
  emailVerifiedAt      DateTime?            @map("email_verified_at")
  phoneVerifiedAt      DateTime?            @map("phone_verified_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")
  studentProfile       StudentProfile?
  parentProfile        ParentProfile?
  uploadedFiles        File[]               @relation("FileUploadedBy")
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  parentLinksAsParent  ParentStudentLink[]  @relation("ParentStudentLinksParent")
  parentLinksAsStudent ParentStudentLink[]  @relation("ParentStudentLinksStudent")
  backgroundJobs       BackgroundJob[]      @relation("BackgroundJobOwner")
  auditLogs            AuditLog[]           @relation("AuditLogActor")

  @@index([role, status])
  @@map("users")
}

model StudentProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade       Int
  childCode   String   @unique @map("child_code")
  address     String?
  displayName String?  @map("display_name")
  totalXp     Int      @default(0) @map("total_xp")
  level       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

model ParentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parent_profiles")
}

model ParentStudentLink {
  id            String   @id @default(uuid()) @db.Uuid
  parentUserId  String   @map("parent_user_id") @db.Uuid
  parentUser    User     @relation("ParentStudentLinksParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentUserId String   @unique @map("student_user_id") @db.Uuid
  studentUser   User     @relation("ParentStudentLinksStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([parentUserId, studentUserId])
  @@map("parent_student_links")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  requestIp String?   @map("request_ip")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model File {
  id           String         @id @default(uuid()) @db.Uuid
  provider     FileProvider   @default(CLOUDFLARE_R2)
  purpose      FilePurpose
  bucket       String
  objectKey    String         @unique @map("object_key")
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    BigInt         @map("size_bytes")
  visibility   FileVisibility @default(PRIVATE)
  status       FileStatus     @default(UPLOADED)
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?          @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarUsers  User[]         @relation("UserAvatar")
  publicUrl    String?        @map("public_url")
  checksum     String?
  metadataJson Json?          @map("metadata_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  @@index([purpose, status])
  @@index([uploadedById])
  @@index([visibility, status])
  @@map("files")
}

model BackgroundJob {
  id           String              @id @default(uuid()) @db.Uuid
  queue        BackgroundJobQueue
  status       BackgroundJobStatus @default(QUEUED)
  bullmqJobId  String?             @map("bullmq_job_id")
  ownerUserId  String?             @map("owner_user_id") @db.Uuid
  ownerUser    User?               @relation("BackgroundJobOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lessonId     String?             @map("lesson_id") @db.Uuid
  resourceType String?             @map("resource_type")
  resourceId   String?             @map("resource_id") @db.Uuid
  inputMeta    Json?               @map("input_meta_json")
  result       Json?               @map("result_json")
  errorMessage String?             @map("error_message") @db.Text
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3) @map("max_attempts")
  availableAt  DateTime?           @map("available_at")
  startedAt    DateTime?           @map("started_at")
  finishedAt   DateTime?           @map("finished_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([bullmqJobId])
  @@index([ownerUserId, createdAt])
  @@index([queue, status])
  @@index([resourceType, resourceId])
  @@map("background_jobs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?    @map("before_json")
  after       Json?    @map("after_json")
  metadata    Json?    @map("metadata_json")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
