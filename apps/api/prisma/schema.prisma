  adminUser   User             @relation("ReportActionAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  action      ModerationAction
  note        String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([reportId])
  @@index([adminUserId])
  @@map("report_actions")
}

model AiGeneration {
