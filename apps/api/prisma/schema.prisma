  currency        String               @default("USD")
  sourceUrl       String?              @map("source_url")
  effectiveFrom   DateTime             @map("effective_from")
  effectiveTo     DateTime?            @map("effective_to")
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  rates           ProviderPriceRate[]
  usageEvents     ProviderUsageEvent[]

  @@index([catalogItemId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@map("provider_price_versions")
}

model ProviderPriceRate {
  id             String               @id @default(uuid()) @db.Uuid
  priceVersionId String               @map("price_version_id") @db.Uuid
  priceVersion   ProviderPriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Cascade)
  metric         ProviderUsageMetric
  unitSize       Decimal              @default(1) @map("unit_size") @db.Decimal(20, 6)
  unitPriceUsd   Decimal              @map("unit_price_usd") @db.Decimal(20, 10)
  tierFrom       Int?                 @map("tier_from")
  tierTo         Int?                 @map("tier_to")
  conditionsJson Json?                @map("conditions_json")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([priceVersionId, metric])
  @@map("provider_price_rates")
}

model AiFeatureModelConfig {
  id                    String               @id @default(uuid()) @db.Uuid
  feature               AiGenerationType     @unique
  primaryCatalogItemId  String               @map("primary_catalog_item_id") @db.Uuid
  primaryCatalogItem    ProviderCatalogItem  @relation("AiFeaturePrimaryCatalogItem", fields: [primaryCatalogItemId], references: [id], onDelete: Restrict)
  fallbackCatalogItemId String?              @map("fallback_catalog_item_id") @db.Uuid
  fallbackCatalogItem   ProviderCatalogItem? @relation("AiFeatureFallbackCatalogItem", fields: [fallbackCatalogItemId], references: [id], onDelete: SetNull)

  temperature     Decimal? @db.Decimal(4, 3)
  reasoningEffort String?  @map("reasoning_effort")
  maxInputTokens  Int?     @map("max_input_tokens")
  maxOutputTokens Int?     @map("max_output_tokens")

  fallbackTemperature     Decimal? @map("fallback_temperature") @db.Decimal(4, 3)
  fallbackReasoningEffort String?  @map("fallback_reasoning_effort")
  fallbackMaxOutputTokens Int?     @map("fallback_max_output_tokens")

  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([primaryCatalogItemId])
  @@index([fallbackCatalogItemId])
  @@map("ai_feature_model_configs")
}

model ProviderUsageEvent {
  id                    String                     @id @default(uuid()) @db.Uuid
  category              ProviderCatalogCategory
  provider              String
  catalogItemId         String?                    @map("catalog_item_id") @db.Uuid
  catalogItem           ProviderCatalogItem?       @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  priceVersionId        String?                    @map("price_version_id") @db.Uuid
  priceVersion          ProviderPriceVersion?      @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  aiGenerationId        String?                    @map("ai_generation_id") @db.Uuid
  aiGeneration          AiGeneration?              @relation("ProviderUsageAiGeneration", fields: [aiGenerationId], references: [id], onDelete: SetNull)
  backgroundJobId       String?                    @map("background_job_id") @db.Uuid
  backgroundJob         BackgroundJob?             @relation("ProviderUsageBackgroundJob", fields: [backgroundJobId], references: [id], onDelete: SetNull)
  sourceDocumentId      String?                    @map("source_document_id") @db.Uuid
  sourceDocument        SourceDocument?            @relation("ProviderUsageSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  feature               AiGenerationType?
  attempt               Int                        @default(1)
  providerRequestId     String?                    @map("provider_request_id")
  status                ProviderUsageStatus        @default(RUNNING)
  source                ProviderUsageSource        @default(MEASURED)
  cacheStatus           String?                    @map("cache_status")
  promptTokens          Int                        @default(0) @map("prompt_tokens")
  cachedInputTokens     Int                        @default(0) @map("cached_input_tokens")
  completionTokens      Int                        @default(0) @map("completion_tokens")
  totalTokens           Int                        @default(0) @map("total_tokens")
  pages                 Int                        @default(0)
  requestCount          Int                        @default(1) @map("request_count")
  rawUsageJson          Json?                      @map("raw_usage_json")
  estimatedCostUsd      Decimal                    @default(0) @map("estimated_cost_usd") @db.Decimal(20, 10)
  costVnd               Int                        @default(0) @map("cost_vnd")
  fxRateVndPerUsd       Decimal                    @default(25000) @map("fx_rate_vnd_per_usd") @db.Decimal(12, 4)
  estimatedSavedCostUsd Decimal                    @default(0) @map("estimated_saved_cost_usd") @db.Decimal(20, 10)
  estimatedSavedCostVnd Int                        @default(0) @map("estimated_saved_cost_vnd")
  latencyMs             Int?                       @map("latency_ms")
  errorCode             String?                    @map("error_code")
  startedAt             DateTime                   @default(now()) @map("started_at")
  finishedAt            DateTime?                  @map("finished_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  budgetReservation     ProviderBudgetReservation?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([provider, catalogItemId, createdAt])
  @@index([feature, createdAt])
  @@index([status, createdAt])
  @@index([aiGenerationId])
  @@index([backgroundJobId])
  @@index([sourceDocumentId])
  @@map("provider_usage_events")
}

model ProviderBudgetReservation {
  id               String                          @id @default(uuid()) @db.Uuid
  idempotencyKey   String                          @unique @map("idempotency_key")
  periodKey        String                          @map("period_key") @db.VarChar(7)
  category         ProviderCatalogCategory
  status           ProviderBudgetReservationStatus @default(RESERVED)
  reservedVnd      Int                             @map("reserved_vnd")
  settledVnd       Int                             @default(0) @map("settled_vnd")
  usageEventId     String                          @unique @map("usage_event_id") @db.Uuid
  usageEvent       ProviderUsageEvent              @relation(fields: [usageEventId], references: [id], onDelete: Restrict)
  backgroundJobId  String?                         @map("background_job_id") @db.Uuid
  backgroundJob    BackgroundJob?                  @relation("ProviderBudgetReservationBackgroundJob", fields: [backgroundJobId], references: [id], onDelete: SetNull)
  aiGenerationId   String?                         @map("ai_generation_id") @db.Uuid
  aiGeneration     AiGeneration?                   @relation("ProviderBudgetReservationAiGeneration", fields: [aiGenerationId], references: [id], onDelete: SetNull)
  sourceDocumentId String?                         @map("source_document_id") @db.Uuid
  sourceDocument   SourceDocument?                 @relation("ProviderBudgetReservationSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  expiresAt        DateTime                        @map("expires_at")
  heartbeatAt      DateTime                        @default(now()) @map("heartbeat_at")
  settledAt        DateTime?                       @map("settled_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")

  @@index([periodKey, status, category])
  @@index([backgroundJobId])
  @@index([aiGenerationId])
  @@index([sourceDocumentId])
  @@map("provider_budget_reservations")
}

model ProviderBudgetPolicy {
