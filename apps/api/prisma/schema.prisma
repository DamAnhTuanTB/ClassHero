  status                     AiGenerationStatus          @default(QUEUED)
  provider                   AiProviderName?
  model                      String?
  createdByUserId            String?                     @map("created_by_user_id") @db.Uuid
  createdByUser              User?                       @relation("AiGenerationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lessonId                   String?                     @map("lesson_id") @db.Uuid
  lesson                     Lesson?                     @relation("AiGenerationLesson", fields: [lessonId], references: [id], onDelete: SetNull)
  backgroundJobId            String?                     @map("background_job_id") @db.Uuid
  backgroundJob              BackgroundJob?              @relation("AiGenerationBackgroundJob", fields: [backgroundJobId], references: [id], onDelete: SetNull)
  targetType                 String?                     @map("target_type")
  targetId                   String?                     @map("target_id") @db.Uuid
  promptVersion              String?                     @map("prompt_version")
  schemaVersion              String?                     @map("schema_version")
  inputHash                  String?                     @map("input_hash")
  outputHash                 String?                     @map("output_hash")
  inputMetaJson              Json?                       @map("input_meta_json")
  outputJson                 Json?                       @map("output_json")
  errorMessage               String?                     @map("error_message") @db.Text
  providerRequestId          String?                     @map("provider_request_id")
  promptTokens               Int?                        @map("prompt_tokens")
  completionTokens           Int?                        @map("completion_tokens")
  totalTokens                Int?                        @map("total_tokens")
  estimatedCostVnd           Int?                        @map("estimated_cost_vnd")
  latencyMs                  Int?                        @map("latency_ms")
  retryCount                 Int                         @default(0) @map("retry_count")
  startedAt                  DateTime?                   @map("started_at")
  finishedAt                 DateTime?                   @map("finished_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  lessonSummaries            LessonSummary[]             @relation("LessonSummaryAiGeneration")
  quizSets                   QuizSet[]                   @relation("QuizSetAiGeneration")
  flashcardSets              FlashcardSet[]              @relation("FlashcardSetAiGeneration")
  testSets                   TestSet[]                   @relation("TestSetAiGeneration")
  explanations               AiExplanation[]
  chatMessages               AiChatMessage[]
  summaries                  ConversationSummary[]
  providerUsageEvents        ProviderUsageEvent[]        @relation("ProviderUsageAiGeneration")
  providerBudgetReservations ProviderBudgetReservation[] @relation("ProviderBudgetReservationAiGeneration")
