{
  "name": "@learning-path/api",
  "private": true,
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-with-metadata.mjs",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:check": "tsc --noEmit -p tsconfig.seed.json",
    "db:validate": "prisma validate --config prisma.config.ts",
    "lint": "eslint .",
    "prisma": "prisma --config prisma.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
