{
  "name": "@learning-path/api",
  "private": true,
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-with-metadata.mjs & tsx watch src/workers/main.ts",
    "dev:api": "node scripts/dev-with-metadata.mjs",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:check": "tsc --noEmit -p tsconfig.seed.json",
    "db:validate": "prisma validate --config prisma.config.ts",
    "lint": "eslint .",
    "prisma": "prisma --config prisma.config.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:m4.2": "vitest run test/m4.2-document-helpers.test.ts test/m4.2-document-api.int.test.ts",
    "test:m4.3": "vitest run test/m4.3-worker-foundation.test.ts",
    "test:m4.4": "vitest run test/m4.4-document-processing.test.ts test/m4.4-ocr-pipeline.e2e.test.ts",
    "test:m4.4:live": "pnpm build && tsx test/m4.4-live-mathpix-minio.ts",
    "worker:dev": "tsx watch src/workers/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.80.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1",
    "yauzl": "^3.4.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/node": "24.10.4",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
