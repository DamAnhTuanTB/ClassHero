# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to control Codex.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional comma-separated chat IDs for task completion notifications.
# Defaults to TELEGRAM_ALLOWED_CHAT_IDS when empty.
TELEGRAM_NOTIFY_CHAT_IDS=

# Codex execution settings for Telegram messages.
CODEX_TELEGRAM_SESSION_MODE=telegram-thread
CODEX_TELEGRAM_SANDBOX=danger-full-access
CODEX_TELEGRAM_APPROVAL_POLICY=never
CODEX_TELEGRAM_ENABLE_SEARCH=0
CODEX_TELEGRAM_TIMEOUT_SECONDS=7200
CODEX_TELEGRAM_SKIP_OLD_UPDATES_ON_START=1
CODEX_TELEGRAM_TRANSCRIPT_ENABLED=1
CODEX_TELEGRAM_TRANSCRIPT_FILE=.codex/telegram/transcript.md
